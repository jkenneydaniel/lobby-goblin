# Copy to .env.fleet, using a fresh 32-character lowercase hex FLEET_ID.
# Fleet.ps1 / Fleet.sh generate the ID automatically. Never copy a different host's ID.
FLEET_ID=replace_with_a_fresh_32_hex_id
FLEET_IMAGE=ghcr.io/jkenneydaniel/lobby-goblin:0.3.9-alpha
FLEET_ADDRESS=localhost
FLEET_PANEL_PORT=8082
FLEET_PANEL_BIND=0.0.0.0
FLEET_GAME_BIND=0.0.0.0
FLEET_GAME_PORT_BASE=35000
# Includes each game's memory limit plus 1 GiB per controller.
FLEET_MEMORY_GIB=16
