{
  "version": 1,
  "images": [
    {
      "id": "server",
      "manifest": "images/image.json",
      "dockerfile": "Dockerfile",
      "dependencies": ["shared/steamcmd/runtime"],
      "files": [
        {
          "source": "images/Dockerfile",
          "target": "Dockerfile"
        },
        {
          "source": "images/entrypoint.mjs",
          "target": "entrypoint.mjs"
        },
        {
          "source": "images/package.json",
          "target": "package.json"
        },
        {
          "source": "images/package-lock.json",
          "target": "package-lock.json"
        },
        {
          "source": "transport.js",
          "target": "transport.js"
        }
      ],
      "buildArgs": {
        "BASE_IMAGE": "baseImage"
      },
      "checks": [
        {
          "runner": "node-test",
          "file": "images/test-runtime.test.mjs"
        }
      ],
      "acceptance": ["images/acceptance.mjs"]
    },
    {
      "id": "managed",
      "manifest": "images/managed/image.json",
      "dockerfile": "Dockerfile",
      "dependencies": ["shared/steamcmd/runtime"],
      "files": [
        {
          "source": "images/managed/Dockerfile",
          "target": "Dockerfile"
        },
        {
          "source": "images/managed-entrypoint.mjs",
          "target": "managed-entrypoint.mjs"
        },
        {
          "source": "images/entrypoint.mjs",
          "target": "entrypoint.mjs"
        },
        {
          "source": "images/package.json",
          "target": "package.json"
        },
        {
          "source": "images/package-lock.json",
          "target": "package-lock.json"
        },
        {
          "source": "transport.js",
          "target": "transport.js"
        },
        {
          "source": "images/managed-helper.mjs",
          "target": "managed-helper.mjs"
        },
        {
          "source": "images/managed-health.mjs",
          "target": "managed-health.mjs"
        },
        {
          "source": "mod-layout.js",
          "target": "mod-layout.js"
        },
        {
          "source": "mod-runtime-tools.json",
          "target": "mod-runtime-tools.json"
        }
      ],
      "buildArgs": {
        "BASE_IMAGE": "baseImage"
      },
      "checks": [
        {
          "runner": "node-test",
          "file": "images/test-managed.test.mjs"
        },
        {
          "runner": "node-test",
          "file": "images/test-managed-mods.test.mjs"
        }
      ],
      "acceptance": ["images/managed-acceptance.mjs"]
    }
  ]
}
