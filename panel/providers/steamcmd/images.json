{
  "version": 1,
  "images": [{
    "id": "runtime",
    "manifest": "images/image.json",
    "dockerfile": "Dockerfile",
    "files": [{"source": "images/Dockerfile", "target": "Dockerfile"}],
    "buildArgs": {"BASE_IMAGE": "baseImage", "STEAMCMD_SHA256": "steamcmdSha256"},
    "checks": [{"runner": "node-test", "file": "metadata.test.mjs"}, {"runner": "node-test", "file": "provider.test.mjs"}],
    "acceptance": ["images/acceptance.mjs"]
  }]
}
