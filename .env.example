# Copy to .env and set your Docker host's reserved LAN IPv4 address or DNS name.
# No scheme, port, or trailing slash. localhost permits access from this PC only.
SERVER_ADDRESS=localhost
PANEL_EXTRA_HOSTS=
PANEL_PORT=8080
GAME_PORT=34197
FACTORIO_IMAGE=ghcr.io/jkenneydaniel/factorio-server:2.0.77-fc.3
# Existing legacy installations migrate automatically after a verified backup.
# Native on x86-64; requires amd64 emulation on ARM64. Keep this for 2.0.77.
FACTORIO_PLATFORM=linux/amd64
PANEL_IMAGE=ghcr.io/jkenneydaniel/lobby-goblin:0.3.21-alpha
# Docker Desktop: 0. Linux: run `stat -c %g /var/run/docker.sock` and use that ID.
DOCKER_SOCKET_GID=0
FACTORIO_CONTAINER=factorio-server
CONTROLLER_CONTAINER=factorio-panel-controller
PANEL_CONTAINER=factorio-panel
# Automatic public metadata checks. Installation requires an administrator.
RELEASE_CHECKS=true
RELEASE_REPOSITORY=jkenneydaniel/lobby-goblin
# preview includes alpha/beta releases; stable excludes all prereleases.
RELEASE_CHANNEL=preview
